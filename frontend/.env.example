# Copy to .env.local for local dev. In Vercel, set these in Project Settings -> Environment Variables.
# Only these names are public (exposed to the browser). Never put LLM/OCR/STT or other secrets here.

# Base URL of the backend API (no trailing slash), e.g. https://vidyaai-api-xxxx.a.run.app
NEXT_PUBLIC_API_URL=

# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
