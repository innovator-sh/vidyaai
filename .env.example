# ============================================================================
# BACKEND (main/backend) - names only, never commit real values.
# Production: store these in Secret Manager and inject as env vars.
# ============================================================================
# dev | test | prod.  In prod the app refuses to start if a required secret is missing.
ENV=dev

# Postgres (Neon: use the POOLED connection string; postgres:// or postgresql:// is fine,
# ?sslmode=require is handled).  Local docker compose sets this for you.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Qdrant (Qdrant Cloud URL + API key; local compose uses http://qdrant:6333 with no key)
QDRANT_URL=https://YOUR-CLUSTER.qdrant.io:6333
QDRANT_API_KEY=

# LLM / OCR / STT providers (server-side only - rotate any key that was ever in a browser env var)
GROQ_API_KEY=
SARVAM_API_KEY=

# Firebase Admin service account as ONE-LINE JSON string (Firebase console > Project settings >
# Service accounts > Generate new private key; paste the whole JSON).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated explicit allow-list (no "*"): Vercel production + preview origins.
CORS_ORIGINS=http://localhost:3000,https://YOUR-APP.vercel.app
# Optional regex for Vercel preview URLs, e.g. ^https://your-app-[a-z0-9-]+\.vercel\.app$
CORS_ORIGIN_REGEX=
# Optional Host allow-list (comma-separated), e.g. api.example.com,*.run.app
ALLOWED_HOSTS=*

# Optional limits (defaults shown)
# RL_CHAT_PER_MIN=20
# RL_UPLOAD_PER_MIN=5
# RL_OCR_STT_PER_MIN=10
# RL_GENERATE_PER_MIN=10
# DAILY_QUOTA=300
# MAX_UPLOAD_BYTES=10485760
# MAX_JSON_BYTES=1000000
# CHAT_HISTORY_DEFAULT=10
# CHAT_HISTORY_MAX=20

# Tests only: run the suite against Postgres too (SQLite is the default)
# TEST_DATABASE_URL=postgresql+asyncpg://vidya:vidya_dev_only@localhost:5432/vidyaai_test
